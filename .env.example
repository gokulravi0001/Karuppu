# Discord Security Bot Environment Configuration
# Copy this file to .env and fill in your values. Never commit your real .env file!

# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Channel ID where security alerts, raid warnings, and mod review cards are posted
ALERT_CHANNEL_ID=123456789012345678

# Discord Guild (Server) ID for rapid slash command registration (optional, but speeds up command sync)
GUILD_ID=

# Server Owner ID (Optional override: by default, bot dynamically checks ctx.guild.owner_id)
OWNER_ID=

# Port for internal healthcheck HTTP server (used by Docker healthcheck)
HEALTH_PORT=8080
